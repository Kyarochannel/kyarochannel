<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% if title %}{{ title }} — Kyaro ch.{% else %}Kyaro ch.{% endif %}</title>
    <meta name="description" content="{{ description or 'Kyaro\'s corner of the internet — writing, photos, and a quiet place by the water.' }}" />

    <!-- Set the theme BEFORE the page paints, so there's no light flash when
         navigating in dark mode. Runs immediately, before <body> renders. -->
    <script>
      (function(){var r=document.documentElement,s=null;
      try{s=localStorage.getItem("theme");}catch(e){}
      if(s==="dark"||s==="light")r.setAttribute("data-theme",s);
      else if(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches)r.setAttribute("data-theme","dark");
      else r.setAttribute("data-theme","light");})();
    </script>

    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <a href="#content" id="skip-link">Skip to content</a>
    <div class="layout">

      <header class="site-header">
        <div class="header-art">
          <img class="header-pfp" src="/images/kyaro-pfp.png" alt="Kyaro" />
          <div class="header-words">
            <h1 class="site-title"><a href="/">Kyaro&nbsp;ch.</a></h1>
            <p class="site-tagline">a quiet corner by the water</p>
          </div>
          <button id="theme-toggle" type="button" aria-label="Switch between light and dark"><span class="theme-icon">&#9790;</span></button>
        </div>
        <div class="ticker" aria-label="Today's note">
          <div class="ticker-label">today</div>
          <div class="ticker-track"><span class="ticker-text">
            welcome to the new site &#128012; &nbsp;·&nbsp; the water is calm today &nbsp;·&nbsp; thanks for stopping by &nbsp;·&nbsp; make yourself a tea &#127861; &nbsp;·&nbsp;
            welcome to the new site &#128012; &nbsp;·&nbsp; the water is calm today &nbsp;·&nbsp; thanks for stopping by &nbsp;·&nbsp; make yourself a tea &#127861; &nbsp;·&nbsp;
          </span></div>
        </div>
      </header>

      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-icon" aria-hidden="true">&#9776;</span> Menu
      </button>

      <aside class="sidebar" id="site-nav">
        <nav aria-label="Main navigation">
          <div class="nav-group"><div class="nav-heading">Start</div>
            <ul><li><a href="/"{% if nav == 'home' %} class="active"{% endif %}>Home</a></li></ul></div>
          <div class="nav-group"><div class="nav-heading">Writing</div>
            <ul>
              <li><a href="/blog/"{% if nav == 'blog' %} class="active"{% endif %}>Blog</a></li>
              <li><a href="/articles/"{% if nav == 'articles' %} class="active"{% endif %}>Articles</a></li>
            </ul></div>
          <div class="nav-group"><div class="nav-heading">Pictures</div>
            <ul><li><a href="/gallery/"{% if nav == 'gallery' %} class="active"{% endif %}>Gallery</a></li></ul></div>
          <div class="nav-group"><div class="nav-heading">More</div>
            <ul>
              <li><a href="/about/"{% if nav == 'about' %} class="active"{% endif %}>About</a></li>
              <li><a href="/links/"{% if nav == 'links' %} class="active"{% endif %}>Links</a></li>
            </ul></div>
        </nav>
        <div class="sidebar-card"><p class="small">{{ sidebarNote | safe if sidebarNote else 'Welcome in. Make yourself a tea and stay a while.' }}</p></div>
      </aside>

      <main id="content">
        {{ content | safe }}
      </main>

      <footer class="site-footer"><p>kyarochannel.com &middot; made with care, one file at a time</p></footer>
    </div>

    <script>
      // The theme is already set in <head>. This just wires up the buttons,
      // which have to exist first — so it stays at the end of the page.
      (function(){var r=document.documentElement,b=document.getElementById("theme-toggle");
      if(b){b.addEventListener("click",function(){var n=r.getAttribute("data-theme")==="dark"?"light":"dark";r.setAttribute("data-theme",n);try{localStorage.setItem("theme",n);}catch(e){}});}
      var mt=document.getElementById("menu-toggle"),sb=document.getElementById("site-nav");
      if(mt&&sb){mt.addEventListener("click",function(){var o=sb.classList.toggle("open");mt.setAttribute("aria-expanded",o?"true":"false");});}
      })();
    </script>
  </body>
</html>
